@using UIService.Services
@rendermode InteractiveServer

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Otus Forum</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler"/>

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        @if (AuthService.IsAuthenticated)
        {
            <div class="nav-item px-3 py-2">
                <div class="user-info d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-person-circle me-2"></i>
                        <span class="user-nickname">@AuthService.Nickname</span>
                    </div>
                    <div class="dropdown">
                        <button class="profile-btn dropdown-toggle" type="button" id="userDropdown"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            ⋮
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                            <li>
                                <a class="dropdown-item" href="/profile">
                                    <i class="bi bi-person me-2"></i>Профиль
                                </a>
                            </li>
                            <li>
                                <hr class="dropdown-divider">
                            </li>
                            <li>
                                <a class="dropdown-item text-danger" href="#" @onclick="Logout" @onclick:preventDefault>
                                    <i class="bi bi-box-arrow-up me-2"></i>Выйти
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="dropdown-divider"></div>
        }

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span>Главная
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/topics">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span>Темы форума
            </NavLink>
        </div>

        @if (!AuthService.IsAuthenticated)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/login">
                    <span class="bi bi-box-arrow-in-right" aria-hidden="true"></span>Вход
                </NavLink>
            </div>
        }

        @if (AuthService.IsAuthenticated)
        {
            @if (AuthService.IsAdmin)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/admin-panel">
                        <span class="bi bi-shield-lock" aria-hidden="true"></span>Админка
                    </NavLink>
                </div>
                }
            }
        }
    </nav>
</div>

@implements IDisposable

@code {
    [Inject] private AuthService AuthService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    private bool _initialized;

    protected override void OnInitialized()
    {
        AuthService.OnChanged += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_initialized)
        {
            await AuthService.InitializeAsync();
            _initialized = true;
            StateHasChanged();
        }
    }

    protected void Dispose()
    {
        AuthService.OnChanged -= StateHasChanged;
    }

    void IDisposable.Dispose()
    {
        Dispose();
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/");
    }

    private void NavigateToProfile()
    {
        Navigation.NavigateTo("/profile");
    }
}