@page "/topics/new"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using OtusForum.UI.Clients.Topics
@inject ITopicsClient TopicsService
@inject UIService.Services.AuthService AuthService
@inject NavigationManager Navigation

<div class="container mt-4" style="max-width: 600px;">
    <div class="mb-3">
        <a href="/topics" class="text-decoration-none d-inline-flex align-items-center">
            <i class="bi bi-arrow-left me-1"></i>Вернуться к темам
        </a>
    </div>

    <h2 class="mb-4">
        <i class="bi bi-plus-circle me-2"></i>Создание новой темы
    </h2>

    @if (!AuthService.IsAuthenticated)
    {
        <div class="alert alert-warning shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>Для создания темы необходимо <NavLink href="/login">войти в систему</NavLink>.
        </div>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger shadow-sm" role="alert">
            ❌ @_errorMessage
        </div>
    }

    @* Форма ввода с нативной валидацией .NET 10 *@
    <EditForm Model="@_formModel" OnValidSubmit="HandleValidSubmit" FormName="CreateTopicForm">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label for="title" class="form-label fw-bold">Заголовок темы</label>
            <InputText id="title" class="form-control form-control-lg" @bind-Value="_formModel.Title"
                       placeholder="Введите краткое, но понятное название"
                       maxlength="100" />
            <div class="d-flex justify-content-between align-items-center mt-1">
                <div class="form-text">Минимум 5, максимум 100 символов</div>
                <div class="form-text">@(_formModel.Title.Length) / 100</div>
            </div>
            <ValidationMessage For="@(() => _formModel.Title)" class="text-danger small mt-1" />
        </div>

        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">Отмена</button>
            <button type="submit" class="btn btn-primary px-4" disabled="@_isSubmitting">
                @if (_isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Публикация...</span>
                }
                else
                {
                    <span>Опубликовать тему</span>
                }
            </button>
        </div>
    </EditForm>
</div>

@code {
    private TopicFormModel _formModel = new();
    private bool _isSubmitting = false;
    private string? _errorMessage;

    private async Task HandleValidSubmit()
    {
        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            if (!AuthService.IsAuthenticated)
            {
                _errorMessage = "Необходимо авторизоваться для создания темы.";
                return;
            }

            var request = new CreateTopicRequest
            {
                Title = _formModel.Title
            };

            // Пробрасываем userId и роли в заголовках X-UserId, X-IsAdmin, X-IsModerator
            await TopicsService.CreateAsync(AuthService.UserId, AuthService.IsAdmin, AuthService.IsModerator, request);

            // Редирект на список тем после успешного сохранения
            Navigation.NavigateTo("/topics");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Не удалось создать тему: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/topics");
    }

    protected override void OnInitialized()
    {
        AuthService.OnChanged += StateHasChanged;
    }

    protected void Dispose()
    {
        AuthService.OnChanged -= StateHasChanged;
    }

    // Внутренняя модель для UI-валидации полей ввода
    public class TopicFormModel
    {
        [Required(ErrorMessage = "Заголовок темы обязателен для заполнения")]
        [StringLength(100, MinimumLength = 5, ErrorMessage = "Заголовок должен содержать от 5 до 100 символов")]
        public string Title { get; set; } = string.Empty;
    }
}
