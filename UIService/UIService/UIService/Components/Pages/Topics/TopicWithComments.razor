@page "/topics/{TopicId:long}"
@rendermode InteractiveServer
@using System.Collections.Generic
@using System.Linq
@using OtusForum.UI.Clients.Comments
@using OtusForum.UI.Clients.Topics
@using Microsoft.AspNetCore.Components.Web
@inject ITopicsClient TopicsService
@inject ICommentsClient CommentsClient
@inject UIService.Services.AuthService AuthService
@inject UIService.Services.CommentRefreshService CommentRefreshService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>@_topicWithComments?.Title</PageTitle>

@if (_isLoading)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Загрузка...</span>
        </div>
    </div>
}
else if (_topicWithComments == null)
{
    <div class="container mt-5">
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>Тема не найдена.
        </div>
        <a href="/topics" class="btn btn-outline-primary">← Вернуться к списку тем</a>
    </div>
}
else
{
    <div class="container mt-4">
        <div class="mb-3">
            <a href="/topics" class="btn btn-link p-0 text-decoration-none">← Вернуться к списку тем</a>
        </div>

        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">@_topicWithComments.Title</h4>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="badge bg-secondary">
                        <i class="bi bi-person me-1"></i>
                        Автор: @(_topicWithComments.AuthorId)
                    </span>
                    <div class="d-flex align-items-center gap-2">
                        @if (AuthService.IsAuthenticated && AuthService.UserId == _topicWithComments.AuthorId)
                        {
                            <button class="btn btn-sm btn-outline-primary" @onclick="ToggleEditModal">
                                <i class="bi bi-pencil me-1"></i>Редактировать
                            </button>
                        }
                        <span class="text-muted small">
                            <i class="bi bi-clock me-1"></i>
                            @_topicWithComments.CreatedAt.ToString("g")
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <h5 class="mb-3">
            <i class="bi bi-chat-left-text me-2"></i>
            Комментарии @_topicWithComments.Comments.Count
        </h5>

        @if (!_topicWithComments.Comments.Any())
        {
            <div class="alert alert-info" role="alert">
                <i class="bi bi-info-circle me-2"></i>Комментариев пока нет. Станьте первым!
            </div>
        }
        else
        {
            @* Получаем корневые комментарии (без родителя) *@
            var rootComments = _topicWithComments.Comments
                .Where(c => c.ParentCommentId == null)
                .OrderBy(c => c.CreatedAt)
                .ToList();

            @foreach (var comment in rootComments)
            {
                <CommentItem Comment="comment" AllComments="_topicWithComments.Comments.ToList()" TopicId="TopicId" />
            }
        }

        @if (AuthService.IsAuthenticated)
        {
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Оставить комментарий</h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(_submitMessage))
                    {
                        <div class="alert @_submitMessageType role="alert">
                            @_submitMessage
                        </div>
                    }

                    <div class="mb-3">
                        <label for="commentContent" class="form-label">Ваш комментарий</label>
                        <textarea class="form-control" id="commentContent" rows="4" @bind="_commentContent" placeholder="Введите текст комментария..." maxlength="5000"></textarea>
                        <div class="form-text text-muted">@(_commentContent.Length)/5000 символов</div>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <button class="btn btn-success px-4" @onclick="SubmitCommentAsync" disabled="@_isSubmitting">
                            @if (_isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Отправка...</span>
                            }
                            else
                            {
                                <i class="bi bi-send me-1"></i>
                                <Text>Отправить</Text>
                            }
                        </button>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning mb-4" role="alert">
                <i class="bi bi-info-circle me-2"></i>Для добавления комментариев необходимо <NavLink href="/login">войти в систему</NavLink>.
            </div>
        }
    </div>

    @* Модальное окно редактирования темы *@
    @if (_showEditModal)
    {
        <div class="modal fade show" id="editTopicModal" tabindex="-1" style="display: block; background-color: rgba(0, 0, 0, 0.5);" data-bs-dismiss="modal">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content shadow">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title">
                            <i class="bi bi-pencil-square me-2"></i>Редактирование темы
                        </h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="ToggleEditModal"></button>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(_editErrorMessage))
                        {
                            <div class="alert alert-danger" role="alert">
                                <i class="bi bi-exclamation-triangle me-2"></i>@_editErrorMessage
                            </div>
                        }

                        <div class="mb-3">
                            <label for="editTopicTitle" class="form-label fw-bold">Заголовок темы</label>
                            <InputText id="editTopicTitle" class="form-control form-control-lg" @bind-Value="_editTopicTitle" />
                            <div class="form-text text-muted">@(_editTopicTitle?.Length ?? 0)/100 символов</div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="ToggleEditModal">
                            <i class="bi bi-x-circle me-1"></i>Отмена
                        </button>
                        <button type="button" class="btn btn-primary" @onclick="UpdateTopicAsync">
                            @if (_isUpdating)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Сохранение...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-circle me-1"></i>
                                <span>Сохранить</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public long TopicId { get; set; }

    private GetTopicWithCommentsResponse? _topicWithComments;
    private bool _isLoading = true;
    private string _commentContent = string.Empty;
    private bool _isSubmitting = false;
    private string? _submitMessage;
    private string _submitMessageType = "alert-info";

    private bool _initialized;
    private bool _showEditModal = false;
    private string _editTopicTitle = string.Empty;
    private bool _isUpdating = false;
    private string? _editErrorMessage;

    protected override void OnInitialized()
    {
        CommentRefreshService.OnCommentChanged += OnCommentChanged;
    }

    protected void Dispose()
    {
        CommentRefreshService.OnCommentChanged -= OnCommentChanged;
    }

    private async Task OnCommentChanged()
    {
        await ReloadCommentsAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadTopicWithCommentsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadTopicWithCommentsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_initialized)
        {
            await AuthService.InitializeAsync(JSRuntime);
            _initialized = true;
            StateHasChanged();
        }
    }

    private async Task LoadTopicWithCommentsAsync()
    {
        try
        {
            _topicWithComments = await TopicsService.WithCommentsAsync(TopicId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при получении темы с комментариями: {ex.Message}");
            _topicWithComments = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ReloadCommentsAsync()
    {
        await LoadTopicWithCommentsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task SubmitCommentAsync()
    {
        if (string.IsNullOrWhiteSpace(_commentContent))
        {
            _submitMessage = "Комментарий не может быть пустым.";
            _submitMessageType = "alert-danger";
            return;
        }

        if (!AuthService.IsAuthenticated)
        {
            _submitMessage = "Необходимо авторизоваться для добавления комментария.";
            _submitMessageType = "alert-danger";
            return;
        }

        _isSubmitting = true;
        _submitMessage = null;

        try
        {
            var request = new CreateCommentRequest
            {
                TopicId = TopicId,
                Content = _commentContent.Trim()
            };

            await CommentsClient.CreateAsync(AuthService.UserId, request);

            _commentContent = string.Empty;
            _submitMessage = "Комментарий успешно добавлен!";
            _submitMessageType = "alert-success";

            await LoadTopicWithCommentsAsync();
        }
        catch (Exception ex)
        {
            _submitMessage = $"Не удалось добавить комментарий: {ex.Message}";
            _submitMessageType = "alert-danger";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void ToggleEditModal()
    {
        _showEditModal = !_showEditModal;
        _editErrorMessage = null;

        if (_showEditModal)
        {
            _editTopicTitle = _topicWithComments?.Title ?? string.Empty;
        }
    }

    private async Task UpdateTopicAsync()
    {
        if (!AuthService.IsAuthenticated)
        {
            _editErrorMessage = "Необходимо авторизоваться для редактирования темы.";
            StateHasChanged();
            return;
        }

        if (string.IsNullOrWhiteSpace(_editTopicTitle))
        {
            _editErrorMessage = "Заголовок темы не может быть пустым.";
            StateHasChanged();
            return;
        }

        if (_editTopicTitle.Length < 5)
        {
            _editErrorMessage = "Заголовок должен содержать минимум 5 символов.";
            StateHasChanged();
            return;
        }

        _isUpdating = true;
        _editErrorMessage = null;
        StateHasChanged();

        try
        {
            var request = new UpdateTopicRequest
            {
                Title = _editTopicTitle.Trim()
            };

            await TopicsService.TopicAsync(TopicId, AuthService.UserId, request);

            _showEditModal = false;
            await LoadTopicWithCommentsAsync();
        }
        catch (Exception ex)
        {
            _editErrorMessage = $"Не удалось обновить тему: {ex.Message}";
            StateHasChanged();
        }
        finally
        {
            _isUpdating = false;
            StateHasChanged();
        }
    }
}
