@page "/topics"
@rendermode InteractiveAuto
@using System.Collections.Generic
@using OtusForum.UI.Clients.Topics
@inject OtusForum.UI.Clients.Topics.ITopicsClient TopicsService

<h3>Темы</h3>

<PageTitle>Темы</PageTitle>

<div class="mb-4">
    <NavLink class="btn btn-outline-primary" href="/topics/new">
        <span class="bi bi-plus-circle" aria-hidden="true"> Создать новую тему</span>
    </NavLink>
</div>

@if (_latestTopics == null)
{
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Загрузка тем...</span>
    </div>
}
else if (!_latestTopics.Any())
{
    <div class="alert alert-info" role="alert">
        На форуме пока нет созданных тем. Станьте первым!
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th scope="col">Название темы</th>
                    <th scope="col" style="width: 200px;">Автор</th>
                    <th scope="col" style="width: 180px;">Дата создания</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var topic in _latestTopics)
                {
                    <tr key="@topic.Id">
                        <td>
                            <a href="/topics/@topic.Id" class="fw-bold text-decoration-none text-dark">
                                @topic.Title
                            </a>
                        </td>
                        <td>
                            <span class="badge bg-secondary text-white">@@@topic.AuthorNikname</span>
                        </td>
                        <td class="text-muted small">
                            @topic.CreatedAt.ToString("g")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <Pagination CurrentPage="_currentPage" TotalCount="_totalTopicsCount" PageSize="_pageSize" OnPageChanged="OnPageChangedAsync" />
}

@code {
    private IReadOnlyCollection<LatestTopicsResponse>? _latestTopics;
    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _totalTopicsCount = 0;

    private async Task LoadTopicsAsync(int page)
    {
        try
        {
            var request = new GetLatestTopicsRequest { Page = page, PageSize = _pageSize };
            var response = await TopicsService.GetLatestAsync(request);

            _latestTopics = response.LatestTopics.ToArray();
            _totalTopicsCount = response.TotalCount;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при получении списка тем: {ex.Message}");
            _latestTopics = Array.Empty<LatestTopicsResponse>();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnPageChangedAsync(int page)
    {
        _currentPage = page;
        await LoadTopicsAsync(page);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadTopicsAsync(1);
    }
}
