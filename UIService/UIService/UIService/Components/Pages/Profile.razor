@page "/profile"
@rendermode InteractiveServer
@using OtusForum.UI.Clients.Topics
@using OtusForum.UI.Clients.Comments
@using OtusForum.UI.Clients.Users
@using UIService.Services
@inject ITopicsClient TopicsClient
@inject ICommentsClient CommentsClient
@inject IUsersClient UsersClient
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Профиль</PageTitle>

<div class="container mt-4">
    <h2 class="mb-4">
        <i class="bi bi-person-circle me-2"></i>Профиль пользователя
    </h2>

    @if (!AuthService.IsAuthenticated)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Для доступа к профилю необходимо <NavLink href="/login" class="fw-bold">войти</NavLink>.
        </div>
    }
    else
    {
        <ul class="nav nav-tabs mb-4" id="profileTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="password-tab" data-bs-toggle="tab"
                        data-bs-target="#password-panel" type="button" role="tab"
                        aria-controls="password-panel" aria-selected="true">
                    <i class="bi bi-key me-1"></i>Смена пароля
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="topics-tab" data-bs-toggle="tab"
                        data-bs-target="#topics-panel" type="button" role="tab"
                        aria-controls="topics-panel" aria-selected="false">
                    <i class="bi bi-list-nested me-1"></i>Мои темы
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="comments-tab" data-bs-toggle="tab"
                        data-bs-target="#comments-panel" type="button" role="tab"
                        aria-controls="comments-panel" aria-selected="false">
                    <i class="bi bi-chat-dots me-1"></i>Мои комментарии
                </button>
            </li>
        </ul>

        <div class="tab-content" id="profileTabContent">
            <!-- Change Password Tab -->
            <div class="tab-pane fade show active" id="password-panel" role="tabpanel" aria-labelledby="password-tab">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Смена пароля</h5>

                        @if (!string.IsNullOrEmpty(_passwordMessage))
                        {
                            <div class="alert @_passwordMessageType" role="alert">
                                @_passwordMessage
                            </div>
                        }

                        <EditForm Model="@_passwordForm" OnValidSubmit="HandlePasswordChange" FormName="PasswordForm">
                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label for="currentPassword" class="form-label">Текущий пароль</label>
                                <InputText id="currentPassword" class="form-control"
                                           @bind-Value="_passwordForm.CurrentPassword"
                                           type="password" />
                                <ValidationMessage For="(() => _passwordForm.CurrentPassword)" class="text-danger" />
                            </div>

                            <div class="mb-3">
                                <label for="newPassword" class="form-label">Новый пароль</label>
                                <InputText id="newPassword" class="form-control"
                                           @bind-Value="_passwordForm.NewPassword"
                                           type="password" />
                                <ValidationMessage For="(() => _passwordForm.NewPassword)" class="text-danger" />
                            </div>

                            <div class="mb-3">
                                <label for="confirmPassword" class="form-label">Подтверждение пароля</label>
                                <InputText id="confirmPassword" class="form-control"
                                           @bind-Value="_passwordForm.ConfirmPassword"
                                           type="password" />
                                <ValidationMessage For="(() => _passwordForm.ConfirmPassword)" class="text-danger" />
                            </div>

                            <button type="submit" class="btn btn-primary" disabled="@_isPasswordSubmitting">
                                @if (_isPasswordSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Сохранение...</span>
                                }
                                else
                                {
                                    <span>Сохранить</span>
                                }
                            </button>
                        </EditForm>
                    </div>
                </div>
            </div>

            <!-- My Topics Tab -->
            <div class="tab-pane fade" id="topics-panel" role="tabpanel" aria-labelledby="topics-tab">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Мои темы</h5>

                        @if (_isTopicsLoading)
                        {
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Загрузка...</span>
                            </div>
                        }
                        else if (!_topics.Any())
                        {
                            <div class="alert alert-info" role="alert">
                                У вас пока нет созданных тем.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-hover align-middle">
                                    <thead class="table-dark">
                                        <tr>
                                            <th scope="col">Название темы</th>
                                            <th scope="col">Дата создания</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var topic in _topics)
                                        {
                                            <tr>
                                                <td>
                                                    <a href="/topics/@topic.Id" class="fw-bold text-decoration-none text-dark">
                                                        @topic.Title
                                                    </a>
                                                </td>
                                                <td class="text-muted small">
                                                    @topic.CreatedAt.ToString("g")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <Pagination CurrentPage="_currentTopicPage" TotalCount="_totalTopicsCount" PageSize="_topicPageSize" OnPageChanged="OnTopicPageChanged" />
                        }
                    </div>
                </div>
            </div>

            <!-- My Comments Tab -->
            <div class="tab-pane fade" id="comments-panel" role="tabpanel" aria-labelledby="comments-tab">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Мои комментарии</h5>

                        @if (_isCommentsLoading)
                        {
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Загрузка...</span>
                            </div>
                        }
                        else if (!_comments.Any())
                        {
                            <div class="alert alert-info" role="alert">
                                У вас пока нет комментариев.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-hover align-middle">
                                    <thead class="table-dark">
                                        <tr>
                                            <th scope="col">Тема</th>
                                            <th scope="col">Содержание</th>
                                            <th scope="col">Дата создания</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var comment in _comments)
                                        {
                                            <tr>
                                                <td>
                                                    <a href="/topics/@comment.TopicId" class="fw-bold text-decoration-none text-dark">
                                                        Перейти к теме
                                                    </a>
                                                </td>
                                                <td>
                                                    <div class="text-truncate" style="max-width: 400px;">
                                                        @comment.Content
                                                    </div>
                                                </td>
                                                <td class="text-muted small">
                                                    @comment.CreatedAt.ToString("g")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <Pagination CurrentPage="_currentCommentPage" TotalCount="_totalCommentsCount" PageSize="_commentPageSize" OnPageChanged="OnCommentPageChanged" />
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private ChangePasswordForm _passwordForm = new();
    private string? _passwordMessage;
    private string _passwordMessageType = "alert-danger";
    private bool _isPasswordSubmitting;

    private List<LatestTopicsResponse> _topics = [];
    private bool _isTopicsLoading = true;
    private int _currentTopicPage = 1;
    private int _topicPageSize = 10;
    private int _totalTopicsCount = 0;

    private List<GetCommentsByUserIdItemResponse> _comments = [];
    private bool _isCommentsLoading = true;
    private int _currentCommentPage = 1;
    private int _commentPageSize = 10;
    private int _totalCommentsCount = 0;

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsAuthenticated)
        {
            await LoadTopicsAsync();
            await LoadCommentsAsync();
        }
    }

    private async Task HandlePasswordChange()
    {
        _passwordMessage = null;
        _isPasswordSubmitting = true;
        _passwordMessageType = "alert-danger";

        if (_passwordForm.NewPassword != _passwordForm.ConfirmPassword)
        {
            _passwordMessage = "Новый пароль и подтверждение не совпадают.";
            _isPasswordSubmitting = false;
            StateHasChanged();
            return;
        }

        if (string.IsNullOrWhiteSpace(_passwordForm.CurrentPassword))
        {
            _passwordMessage = "Введите текущий пароль.";
            _isPasswordSubmitting = false;
            StateHasChanged();
            return;
        }

        if (string.IsNullOrWhiteSpace(_passwordForm.NewPassword) || _passwordForm.NewPassword.Length < 6)
        {
            _passwordMessage = "Новый пароль должен содержать минимум 6 символов.";
            _isPasswordSubmitting = false;
            StateHasChanged();
            return;
        }

        try
        {
            var userId = AuthService.UserId ?? throw new InvalidOperationException("User ID not found.");

            var request = new ChangePasswordRequest
            {
                CurrentPassword = _passwordForm.CurrentPassword,
                NewPassword = _passwordForm.NewPassword
            };

            await UsersClient.ChangePasswordAsync(userId, request);

            _passwordMessageType = "alert-success";
            _passwordMessage = "Пароль успешно изменён.";
            _passwordForm = new();
        }
        catch (Exception ex)
        {
            _passwordMessageType = "alert-danger";
            _passwordMessage = $"Ошибка при смене пароля: {ex.Message}";
        }
        finally
        {
            _isPasswordSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task LoadTopicsAsync(int? page = null)
    {
        _isTopicsLoading = true;
        StateHasChanged();

        try
        {
            var userId = AuthService.UserId ?? throw new InvalidOperationException("User ID not found.");
            var currentPage = page ?? _currentTopicPage;

            var request = new GetTopicsByUserIdRequest
            {
                UserId = userId,
                Page = currentPage,
                PageSize = _topicPageSize
            };

            var response = await TopicsClient.GetByUserIdAsync(request);

            _topics = response.Topics.ToList();
            _totalTopicsCount = response.TotalCount;
            _currentTopicPage = currentPage;
        }
        catch (Exception ex)
        {
            _topics = [];
            _totalTopicsCount = 0;
            Console.WriteLine($"Ошибка при получении тем: {ex.Message}");
        }
        finally
        {
            _isTopicsLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadCommentsAsync(int? page = null)
    {
        _isCommentsLoading = true;
        StateHasChanged();

        try
        {
            var userId = AuthService.UserId ?? throw new InvalidOperationException("User ID not found.");
            var currentPage = page ?? _currentCommentPage;

            var request = new GetCommentsByUserIdRequest
            {
                UserId = userId,
                Page = currentPage,
                PageSize = _commentPageSize
            };

            var response = await CommentsClient.GetByUserIdAsync(request);

            _comments = response.Comments.ToList();
            _totalCommentsCount = response.TotalCount;
            _currentCommentPage = currentPage;
        }
        catch (Exception ex)
        {
            _comments = [];
            _totalCommentsCount = 0;
            Console.WriteLine($"Ошибка при получении комментариев: {ex.Message}");
        }
        finally
        {
            _isCommentsLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnTopicPageChanged(int page)
    {
        await LoadTopicsAsync(page);
    }

    private async Task OnCommentPageChanged(int page)
    {
        await LoadCommentsAsync(page);
    }

    public class ChangePasswordForm
    {
        public string CurrentPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
