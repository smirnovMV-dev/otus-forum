{
  "Jwt": {
    "Issuer": "ForumGateway",
    "Audience": "ForumClients",
    "ExpirationMinutes": 15
  },
  "Auth": {
    "Cookie": {
      "Secure": true,
      "SameSite": "Strict"
    }
  },
  "RefreshTokenCleaner": {
    "CleanupInterval": "00:05:00",
    "RetentionPeriod": "1.00:00:00"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Seq": {
      "ServerUrl": "http://seq:80"
    }
  }
}
