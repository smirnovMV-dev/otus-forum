{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ForumGateway",
    "Audience": "ForumClients",
    "SigningKey": "SuperSecretKeyForForumJwtTokenGeneration2026!@#$",
    "ExpirationMinutes": 15
  },
  "Endpoints": {
    "http": {
      "Url": "http://+:5000"
    },
    "https": {
      "Url": "https://+:7000"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/auth" }
        ]
      },
      "topics-route": {
        "ClusterId": "topics-cluster",
        "Match": {
          "Path": "/api/topics/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/topics" }
        ]
      },
      "comments-route": {
        "ClusterId": "comments-cluster",
        "Match": {
          "Path": "/api/comments/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/comments" }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-service": {
            "Address": "http://auth-users-service:5225"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        }
      },
      "topics-cluster": {
        "Destinations": {
          "topics-service": {
            "Address": "http://topics-service:5294"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        }
      },
      "comments-cluster": {
        "Destinations": {
          "comments-service": {
            "Address": "http://comments-service:5044"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        }
      }
    }
  }
}
