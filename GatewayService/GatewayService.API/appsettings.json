{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Endpoints": {
    "http": {
      "Url": "http://localhost:5000"
    },
    "https": {
      "Url": "https://localhost:7000"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/auth" }
        ]
      },
      "topics-route": {
        "ClusterId": "topics-cluster",
        "Match": {
          "Path": "/api/topics/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/topics" }
        ]
      },
      "comments-route": {
        "ClusterId": "comments-cluster",
        "Match": {
          "Path": "/api/comments/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/comments" }
        ]
      }
    }
  }
}
