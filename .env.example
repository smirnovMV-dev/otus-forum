# Скопируйте этот файл в .env (он в .gitignore) и замените значения.
# Запуск сервисов: из каталога сервиса docker compose --env-file ../.env up -d

# Пароль PostgreSQL (общий для сервисов auth/topics/comments в dev-окружении).
POSTGRES_PASSWORD=change-me

# Ключ подписи JWT. Должен быть одинаковым в Gateway, AuthUsers, Topics и Comments
# и не короче 32 символов.
JWT_SIGNING_KEY=change-me-at-least-32-characters-long

# Ключи приёма логов Seq (необязательны: пустое значение = без ключа).
SEQ_API_KEY_AUTH=
SEQ_API_KEY_GATEWAY=
SEQ_API_KEY_TOPICS=
SEQ_API_KEY_COMMENTS=
SEQ_API_KEY_UI=
